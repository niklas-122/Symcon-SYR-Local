{
    "elements": [
        {
            "type": "ValidationTextBox",
            "name": "IPAddress",
            "caption": "IP-Adresse des SYR Geräts"
        },
        {
            "type": "NumberSpinner",
            "name": "Port",
            "caption": "Port (Standard: 5333)",
            "minimum": 1,
            "maximum": 65535
        },
        {
            "type": "NumberSpinner",
            "name": "UpdateInterval",
            "caption": "Abfrageintervall (Sekunden)",
            "minimum": 0
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Ventil öffnen",
            "onClick": "SYR_SetValveState($id, true);"
        },
        {
            "type": "Button",
            "caption": "Ventil schließen",
            "onClick": "SYR_SetValveState($id, false);"
        },
        {
            "type": "Button",
            "caption": "Daten jetzt aktualisieren",
            "onClick": "SYR_UpdateData($id);"
        }
    ]
}
